<Window x:Class="LimitLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LimitLens.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Limit Lens" Width="420" Height="444" MinWidth="420" MinHeight="260"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutSurface" Color="#A41A1D22" />
        <SolidColorBrush x:Key="FlyoutLayer" Color="#6439434C" />
        <SolidColorBrush x:Key="FlyoutLayerStrong" Color="#7C3D4750" />
        <SolidColorBrush x:Key="FlyoutInsight" Color="#80282C33" />
        <SolidColorBrush x:Key="FlyoutBorder" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="FlyoutDivider" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="FlyoutText" Color="#FFF5F6F8" />
        <SolidColorBrush x:Key="FlyoutMuted" Color="#FFB0B6C1" />
        <SolidColorBrush x:Key="FlyoutDim" Color="#FF858C98" />
        <SolidColorBrush x:Key="FlyoutBlue" Color="#FF68A4FF" />
        <SolidColorBrush x:Key="FlyoutPrediction" Color="#FFB18CFF" />
        <SolidColorBrush x:Key="FlyoutTarget" Color="#FF727B88" />
        <SolidColorBrush x:Key="FlyoutGrid" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="FlyoutTrack" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="FlyoutHover" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="FlyoutPressed" Color="#20FFFFFF" />
        <Thickness x:Key="FlyoutCardBorderThickness">0</Thickness>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        </Style>
        <Style x:Key="FlyoutCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FlyoutMuted}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="FlyoutSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FlyoutIconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FlyoutMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutHover}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutPressed}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlyoutProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource FlyoutTrack}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3.5" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlyoutToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Track" Width="36" Height="20" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" CornerRadius="10"
                                    Background="{DynamicResource FlyoutTrack}">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left" Fill="White" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource FlyoutBlue}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlyoutButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="Background" Value="{DynamicResource FlyoutHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FlyoutBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style x:Key="FlyoutPositionButton" TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="Background" Value="{DynamicResource FlyoutHover}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{DynamicResource FlyoutBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutBlue}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlyoutBackButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="8,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FlyoutPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="FlyoutRoot" Background="{DynamicResource FlyoutSurface}" CornerRadius="0">
        <Grid Margin="10">
            <Grid Visibility="{Binding ShowWidgetGraph, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Background="{DynamicResource FlyoutLayer}" BorderBrush="{DynamicResource FlyoutBorder}"
                            BorderThickness="{DynamicResource FlyoutCardBorderThickness}" CornerRadius="8" Padding="15,13" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="UsageRemainingLabel" Text="Usage remaining" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ForecastRemainingPercent, StringFormat={}{0:0}%}"
                                           HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="UsageRemainingProgress" Style="{StaticResource FlyoutProgress}" Maximum="100"
                                         Value="{Binding ForecastRemainingPercent, Mode=OneWay}"
                                         Foreground="{Binding UsageRemainingBrush}"
                                         Margin="0,13,0,9" />
                            <Grid>
                                <TextBlock Text="{Binding WidgetResetText}" Style="{StaticResource FlyoutCaption}" FontSize="12" />
                                <TextBlock Text="{Binding FreshnessText}" Style="{StaticResource FlyoutCaption}"
                                           HorizontalAlignment="Right" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource FlyoutLayer}" BorderBrush="{DynamicResource FlyoutBorder}"
                            BorderThickness="{DynamicResource FlyoutCardBorderThickness}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Usage trajectory" Style="{StaticResource FlyoutSectionTitle}" />
                            <controls:UsageForecastChart Height="177" Margin="0,8,0,6"
                                RemainingPercent="{Binding ForecastRemainingPercent}"
                                ElapsedPercent="{Binding ForecastElapsedPercent}"
                                ProjectedRemaining="{Binding ForecastProjectedRemaining}"
                                WindowStart="{Binding ForecastWindowStart}"
                                ResetAt="{Binding ForecastResetAt}"
                                ProjectedEmptyAt="{Binding ForecastEmptyAt}"
                                ActualPoints="{Binding ForecastActualPoints}"
                                HasPrediction="{Binding ForecastHasPrediction}"
                                ActualBrush="{DynamicResource FlyoutBlue}"
                                CurrentPointBrush="{Binding UsageRemainingBrush}"
                                EstimateBrush="{DynamicResource FlyoutPrediction}"
                                TargetBrush="{DynamicResource FlyoutTarget}"
                                GridBrush="{DynamicResource FlyoutGrid}"
                                LabelBrush="{DynamicResource FlyoutDim}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="— Actual" Foreground="{DynamicResource FlyoutBlue}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock Text="– – Prediction" Foreground="{DynamicResource FlyoutPrediction}" FontSize="11" Margin="0,0,14,0" />
                                <TextBlock Text="··· Reset pace" Foreground="{DynamicResource FlyoutTarget}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Width="178" Margin="10,0,0,0"
                                Background="{DynamicResource FlyoutLayerStrong}" BorderBrush="{DynamicResource FlyoutBorder}"
                                BorderThickness="{DynamicResource FlyoutCardBorderThickness}" CornerRadius="8" Padding="15,13"
                                Visibility="{Binding CreditsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="Available credits" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CreditsText}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource FlyoutLayerStrong}" BorderBrush="{DynamicResource FlyoutBorder}"
                                BorderThickness="{DynamicResource FlyoutCardBorderThickness}" CornerRadius="8" Padding="15,13">
                            <Grid>
                                <TextBlock Text="Resets available" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ResetCreditsText}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="{DynamicResource FlyoutDivider}" BorderThickness="0,1,0,0"
                        Padding="15,5,0,0" Margin="0,8,0,0">
                    <Grid>
                        <TextBlock x:Name="FooterPlanText" Text="{Binding PlanShortText}"
                                   Foreground="{DynamicResource FlyoutMuted}" FontSize="11.5"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RefreshButton" Style="{StaticResource FlyoutIconButton}"
                                    Command="{Binding RefreshCommand}" ToolTip="Refresh usage now">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE72C;" Margin="0,1,0,0" />
                            </Button>
                            <Button x:Name="SettingsButton" Style="{StaticResource FlyoutIconButton}" Margin="2,0,0,0"
                                    Click="SettingsButton_Click" ToolTip="Settings">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE713;" Margin="0,1,0,0" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding ShowWidgetSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="15,4,0,14" />
                    <Border Background="{DynamicResource FlyoutLayer}" BorderBrush="{DynamicResource FlyoutBorder}"
                            Grid.Row="1" BorderThickness="{DynamicResource FlyoutCardBorderThickness}"
                            CornerRadius="8" Padding="16,8,16,14">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding UseLightTheme}" Style="{StaticResource FlyoutToggle}">
                                <TextBlock x:Name="AppearanceLabel" Text="Light appearance"
                                           Foreground="{DynamicResource FlyoutText}" FontSize="13" />
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource FlyoutDivider}" />
                            <TextBlock x:Name="FlyoutPositionLabel" Text="Flyout position" FontSize="13"
                                       Foreground="{DynamicResource FlyoutText}" Margin="0,11,0,8" />
                            <UniformGrid Columns="3" Margin="-2,0,-2,11">
                                <RadioButton x:Name="FlyoutPositionLeft" GroupName="FlyoutPosition"
                                             Margin="2,0" Style="{StaticResource FlyoutPositionButton}"
                                             IsChecked="{Binding IsFlyoutPositionLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FlyoutPositionLeft}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </RadioButton>
                                <RadioButton x:Name="FlyoutPositionCenter" GroupName="FlyoutPosition"
                                             Margin="2,0" Style="{StaticResource FlyoutPositionButton}"
                                             IsChecked="{Binding IsFlyoutPositionCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FlyoutPositionCenter}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </RadioButton>
                                <RadioButton x:Name="FlyoutPositionRight" GroupName="FlyoutPosition"
                                             Margin="2,0" Style="{StaticResource FlyoutPositionButton}"
                                             IsChecked="{Binding IsFlyoutPositionRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FlyoutText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=FlyoutPositionRight}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </RadioButton>
                            </UniformGrid>
                            <Border Height="1" Background="{DynamicResource FlyoutDivider}" />
                            <CheckBox IsChecked="{Binding ShowCreditsInWidget}" Style="{StaticResource FlyoutToggle}">
                                <TextBlock x:Name="ShowCreditsLabel" Text="Show available credits"
                                           Foreground="{DynamicResource FlyoutText}" FontSize="13" />
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource FlyoutDivider}" />
                            <CheckBox IsChecked="{Binding StartWithWindows}" Style="{StaticResource FlyoutToggle}">
                                <TextBlock x:Name="StartWithWindowsLabel" Text="Start with Windows"
                                           Foreground="{DynamicResource FlyoutText}" FontSize="13" />
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource FlyoutDivider}" />
                            <CheckBox IsChecked="{Binding AlertsEnabled}" Style="{StaticResource FlyoutToggle}">
                                <TextBlock x:Name="UsageAlertsLabel" Text="Usage alerts"
                                           Foreground="{DynamicResource FlyoutText}" FontSize="13" />
                            </CheckBox>
                            <TextBlock Text="Alerts fire once at 25%, 10%, and 0% remaining. The taskbar indicator restores itself after Explorer restarts."
                                       Foreground="{DynamicResource FlyoutMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="3" Margin="7,12,7,0">
                        <Button Style="{StaticResource FlyoutBackButton}" HorizontalAlignment="Left"
                                Click="BackToGraphButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE72B;" Margin="0,1,8,0" />
                                <TextBlock Text="Back to usage" FontSize="12.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
            </Grid>
            </Grid>
    </Border>
</Window>
